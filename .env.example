# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true
MONGODB_DB=nba_shot_quality

# Google Gemini (embeddings + Agent Builder)
GEMINI_API_KEY=

# Google Cloud Agent Builder
AGENT_BUILDER_PROJECT_ID=
AGENT_BUILDER_LOCATION=us-central1
AGENT_BUILDER_AGENT_ID=
GOOGLE_APPLICATION_CREDENTIALS=  # path to service account JSON, or unset for ADC

# Embedding provider: 'gemini' (default, hits Gemini API quota) or
# 'local_sentence_transformers' (runs sentence-transformers/all-mpnet-base-v2
# locally on CPU/GPU, no quotas, ~10-15 min for the full 10,503 shots).
# Both produce 768-dim vectors matching the Atlas Vector Search index.
EMBEDDING_PROVIDER=gemini

# Set to 'true' to recompute summary_embedding on EVERY shot, including ones
# that already have one. REQUIRED when switching providers because the two
# vector spaces don't align — mixing them silently breaks $vectorSearch.
EMBEDDING_OVERWRITE=false

# Embeddings pipeline tuning (apply to whichever provider is active).
EMBEDDING_BATCH_SIZE=50
EMBEDDING_CHECKPOINT_EVERY=500
# Free-tier Gemini quota is 100 embed RPM. Sleep this long between successful
# batches to stay under it. Set to 0 if you're on a paid tier with no RPM cap.
# Local provider auto-defaults this to 0 (no rate limit).
EMBEDDING_SLEEP_SECONDS=90
# Fallback sleep on a 429 when the server doesn't return a retryDelay hint.
EMBEDDING_429_SLEEP_SECONDS=70
