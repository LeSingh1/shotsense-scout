# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true
MONGODB_DB=nba_shot_quality

# Google Gemini (embeddings + Agent Builder)
GEMINI_API_KEY=

# Google Cloud Agent Builder
AGENT_BUILDER_PROJECT_ID=
AGENT_BUILDER_LOCATION=us-central1
AGENT_BUILDER_AGENT_ID=
GOOGLE_APPLICATION_CREDENTIALS=  # path to service account JSON, or unset for ADC

# Embeddings pipeline tuning
EMBEDDING_BATCH_SIZE=50
EMBEDDING_CHECKPOINT_EVERY=500
# Free-tier Gemini quota is 100 embed RPM. Sleep this long between successful
# batches to stay under it. Set to 0 if you're on a paid tier with no RPM cap.
EMBEDDING_SLEEP_SECONDS=90
# Fallback sleep on a 429 when the server doesn't return a retryDelay hint.
EMBEDDING_429_SLEEP_SECONDS=70
